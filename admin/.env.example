# ---------------------------------------------------------------------------
# admin/ — read-only data browser (port 8090)
#
#   Copy to admin/.env and replace every <...> value. .env is git-ignored.
#   server.py reads it on start; real environment variables win.
#   With no .env the local docker defaults apply.
#
# Use a READ-ONLY database user here: this page can show every identity row.
# Comments only on their own line; a "#" after a value becomes part of it.
# ---------------------------------------------------------------------------

ADMIN_PORT=8090

# local: 127.0.0.1, postgres / postgres
PGHOST=<qa-db-host>
PGUSER=<qa-readonly-db-user>
PGPASSWORD=<qa-readonly-db-password>
# One port for every database (typical when they share a server).
# Leave unset locally, where each database has its own port (5442-5448, 5455).
PGPORT=5432

# local: 127.0.0.1:9000 (host:port, no http://), minioadmin / minioadmin
MINIO_ENDPOINT=<qa-minio-host>:9000
MINIO_ACCESS_KEY=<qa-minio-readonly-key>
MINIO_SECRET_KEY=<qa-minio-readonly-secret>
