# ---------------------------------------------------------------------------
# identity-data-deletion-service — environment template (written for QA)
#
#   Copy to deletion-service/.env and replace every <...> value.
#   .env is git-ignored; never commit the real file.
#
# How it is read:
#   * java -jar from this folder (start-all.ps1, run.ps1): the service loads
#     ./.env itself.
#   * Docker: docker run --env-file deletion-service/.env ...
#   * Real environment variables always win over the file.
#
# Local development needs no .env: every variable falls back to the value in
# src/main/resources/application.yml (noted as "local:" above each line).
#
# Format rules: KEY=VALUE, no quotes, comments only on their own line (a "#"
# after a value becomes part of the value), forward slashes in paths.
# ---------------------------------------------------------------------------

SERVER_PORT=8096

# --- MOSIP module databases -------------------------------------------------
# Shared credentials for every datasource below. Any one can override them
# with <NAME>_DB_USERNAME / <NAME>_DB_PASSWORD, e.g. IDREPO_DB_PASSWORD=...
# local: postgres / postgres
DB_USERNAME=<qa-db-user>
DB_PASSWORD=<qa-db-password>

# local: jdbc:postgresql://127.0.0.1:5442/mosip_idmap
IDMAP_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_idmap
# local: jdbc:postgresql://127.0.0.1:5448/mosip_idrepo
IDREPO_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_idrepo
# local: jdbc:postgresql://127.0.0.1:5443/mosip_regprc
REGPRC_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_regprc
# local: jdbc:postgresql://127.0.0.1:5445/mosip_credential
CREDENTIAL_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_credential
# local: jdbc:postgresql://127.0.0.1:5446/mosip_ida
IDA_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_ida
# local: jdbc:postgresql://127.0.0.1:5444/mosip_resident
RESIDENT_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_resident
# The deletion audit database. Create the empty database once; the service
# creates its own table. local: jdbc:postgresql://127.0.0.1:5447/mosip_deletion_audit
AUDIT_DB_URL=jdbc:postgresql://<qa-db-host>:5432/mosip_deletion_audit

# eSignet's own databases, used by module 5 to erase the login.
# local: jdbc:postgresql://127.0.0.1:5455/mosip_mockidentitysystem
MOCKIDENTITY_DB_URL=jdbc:postgresql://<qa-esignet-db-host>:5432/mosip_mockidentitysystem
# local: jdbc:postgresql://127.0.0.1:5455/mosip_esignet
ESIGNET_DB_URL=jdbc:postgresql://<qa-esignet-db-host>:5432/mosip_esignet
# Only if eSignet's databases use different credentials from DB_USERNAME:
# ESIGNET_DB_USERNAME=<user>
# ESIGNET_DB_PASSWORD=<password>
# MOCKIDENTITY_DB_USERNAME=<user>
# MOCKIDENTITY_DB_PASSWORD=<password>

# --- Object store (MinIO / S3) ---------------------------------------------
# local: http://127.0.0.1:9000, minioadmin / minioadmin
MINIO_ENDPOINT=https://<qa-minio-host>
MINIO_ACCESS_KEY=<qa-minio-access-key>
MINIO_SECRET_KEY=<qa-minio-secret-key>
PACKET_MANAGER_BUCKET=packet-manager
LANDING_ZONE_BUCKET=landing-zone
IDREPO_OBJECT_BUCKET=idrepo
# ObjectStore, or DMZServer with the landing-zone NFS share mounted at the path.
LANDING_ZONE_TYPE=ObjectStore
LANDING_ZONE_NFS_PATH=

# --- The delete-UIN page ------------------------------------------------------
# Origin(s) the page is served from: comma-separated, no trailing slash.
# local: http://localhost:5501,http://127.0.0.1:5501
ALLOWED_ORIGINS=https://<qa-delete-uin-host>

# --- eSignet (this service is the relying party) ---------------------------
# local: http://localhost:8088/v1/esignet/oauth/v2/token and .../oidc/userinfo
ESIGNET_TOKEN_URL=https://<qa-esignet-host>/v1/esignet/oauth/v2/token
ESIGNET_USERINFO_URL=https://<qa-esignet-host>/v1/esignet/oidc/userinfo
# local: mosip-collab-delete-uin-client
ESIGNET_CLIENT_ID=<qa-client-id>
# Private key of that client; its public JWK is registered on the eSignet side.
# Generate a new pair for QA; never reuse the local-development key.
# local: classpath:esignet-rp-private-key.pem
ESIGNET_RP_PRIVATE_KEY=file:/run/secrets/esignet-rp-private-key.pem
RETRY_WINDOW_SECONDS=300

# --- Direct API /api/deletion (CLI / Postman) -------------------------------
# Public key that verifies tokens for this API. The local-development pair is
# published in git history, so QA needs its own pair.
# local: classpath:gateway-signing-public.pem
DELETION_API_JWT_PUBLIC_KEY=file:/run/secrets/deletion-api-jwt-public.pem
DELETION_API_JWT_ISSUER=mosip-collab-auth-gateway
DELETION_API_JWT_AUDIENCE=identity-data-deletion-service

# --- Modules -----------------------------------------------------------------
ESIGNET_CLEANUP_ENABLED=true
# Self-registration also needs its datasource. In this file write it as:
#   app.datasources.selfreg.url=jdbc:postgresql://<host>:5432/inji_certify_tan
#   app.datasources.selfreg.username=<user>
#   app.datasources.selfreg.password=<password>
# or, as real environment variables (Docker), APP_DATASOURCES_SELFREG_URL etc.
SELF_REGISTRATION_ENABLED=false

# --- Terminal audit ------------------------------------------------------------
# The readable step-by-step trail on stdout. It prints every claim eSignet
# returns (name, contact details and individual_id, i.e. the plain UIN) no
# matter what CONSOLE_SHOW_PLAIN_UIN says, so it MUST be false wherever real
# identities are processed. The audit database is unaffected.
# local: true (synthetic test data only)
CONSOLE_AUDIT_ENABLED=false
# Only matters when the trail is on; masks the UIN in the header lines.
CONSOLE_SHOW_PLAIN_UIN=false
