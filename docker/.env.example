# ---------------------------------------------------------------------------
# docker/ data stack (MOSIP module databases + audit database + MinIO)
#
#   Copy to docker/.env and replace every <...> value. .env is git-ignored.
#   docker compose reads docker/.env automatically; with no .env the local
#   defaults below apply.
#
# restore-minio.sh and verify.sh do not read this file. If you change the
# MinIO login, export MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (and DUMPS_DIR) in
# the shell before running them.
#
# Comments only on their own line; a "#" after a value becomes part of it.
# ---------------------------------------------------------------------------

# Folder holding the database dumps and the MinIO backup tarball, mounted
# read-only at /dumps. These dumps are NOT in the repository.
# default: ./dumps (docker/dumps, git-ignored)
DUMPS_DIR=<path-to-dump-folder>

# Superuser password of every PostgreSQL container. It is only applied when a
# container's volume is first created; changing it later does not change an
# existing database's password.
# local: postgres
POSTGRES_PASSWORD=<qa-db-password>

# MinIO root login, also the deletion service's MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
# local: minioadmin / minioadmin
MINIO_ROOT_USER=<qa-minio-user>
MINIO_ROOT_PASSWORD=<qa-minio-password>
