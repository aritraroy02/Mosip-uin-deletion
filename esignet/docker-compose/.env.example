# ---------------------------------------------------------------------------
# esignet/docker-compose — the LOCAL eSignet + mock identity stack
#
#   Copy to esignet/docker-compose/.env if you need to change it.
#   .env is git-ignored. docker compose reads it automatically; with no .env
#   the local defaults apply.
#
# In QA you normally do not run this stack at all: the deletion service and
# the delete-UIN page point at the QA eSignet instead (ESIGNET_* variables in
# deletion-service/.env and esignet.* in the delete-uin Helm values).
#
# Comments only on their own line; a "#" after a value becomes part of it.
# ---------------------------------------------------------------------------

# Password of the stack's PostgreSQL (port 5455), used by eSignet and the mock
# identity system. Only applied when the database volume is first created.
# Must match ESIGNET_DB_PASSWORD / MOCKIDENTITY_DB_PASSWORD (or DB_PASSWORD)
# in deletion-service/.env.
# local: postgres
ESIGNET_DB_PASSWORD=<password>
