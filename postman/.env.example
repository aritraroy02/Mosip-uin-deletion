# ---------------------------------------------------------------------------
# postman/ — token helpers for the Postman collections
#
#   Copy to postman/.env and replace every <...> value. .env is git-ignored.
#   The scripts read it on start; real environment variables win.
#   With no .env the local-development keys and URLs apply.
#
# Comments only on their own line; a "#" after a value becomes part of it.
# ---------------------------------------------------------------------------

# mint_client_assertion.py — signs the eSignet /token client assertion.
# Must be the same client and key as the deletion service's ESIGNET_* settings.
# local: ../collab-ui/local-dev/keys/esignet-rp-private-key.pem
ESIGNET_RP_PRIVATE_KEY_PATH=<path-to-qa-esignet-rp-private-key.pem>
ESIGNET_CLIENT_ID=<qa-client-id>
ESIGNET_TOKEN_URL=https://<qa-esignet-host>/v1/esignet/oauth/v2/token

# mint_jwt.py — signs tokens for the deletion service's /api/deletion API.
# Private half of the deletion service's DELETION_API_JWT_PUBLIC_KEY.
# local: ../collab-ui/local-dev/keys/deletion-api-jwt-private.pem
DELETION_API_JWT_PRIVATE_KEY_PATH=<path-to-qa-deletion-api-jwt-private.pem>
DELETION_API_JWT_ISSUER=mosip-collab-auth-gateway
DELETION_API_JWT_AUDIENCE=identity-data-deletion-service
