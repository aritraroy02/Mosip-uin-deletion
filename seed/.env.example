# ---------------------------------------------------------------------------
# seed/ — synthetic test identities (seed.py, teardown.py, verify.py,
# load_mock_identities.py)
#
#   Copy to seed/.env and replace every <...> value. .env is git-ignored.
#   The scripts read it on start; real environment variables win.
#   With no .env the local docker defaults apply.
#
# These scripts WRITE synthetic residents into the databases and remove them
# again. Only point them at an environment that should hold test data.
# Comments only on their own line; a "#" after a value becomes part of it.
# ---------------------------------------------------------------------------

# local: 127.0.0.1, postgres / postgres
PGHOST=<qa-db-host>
PGUSER=<qa-db-user>
PGPASSWORD=<qa-db-password>
# One port for every database. Leave unset locally (5442-5448).
PGPORT=5432

# local: 127.0.0.1:9000 (host:port, no http://), minioadmin / minioadmin
MINIO_ENDPOINT=<qa-minio-host>:9000
MINIO_ACCESS_KEY=<qa-minio-access-key>
MINIO_SECRET_KEY=<qa-minio-secret-key>

# load_mock_identities.py: where test logins are registered.
# local: http://localhost:8082/v1/mock-identity-system
MOCK_IDENTITY_BASE=https://<qa-mock-identity-host>/v1/mock-identity-system
